                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"contributor@example.com\",\n  \"displayName\": \"John Coder\",\n  \"role\": \"CONTRIBUTOR\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        }
      ]
    },
    {
      "name": "2. Projects",
      "item": [
        {
          "name": "Create Project (GitHub)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"projectId\", jsonData.id);",
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Algorithm Challenges\",\n  \"repositoryUrl\": \"https://github.com/TheAlgorithms/Python\",\n  \"ownerId\": {{maintainerId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        }
      ]
    },
    {
      "name": "3. Tasks",
      "item": [
        {
          "name": "Create Task (Factorial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"taskId\", jsonData.id);",
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": {{projectId}},\n  \"title\": \"Calculate Factorial\",\n  \"description\": \"Write a Python script that reads an integer from stdin and prints its factorial.\",\n  \"difficulty\": \"BEGINNER\",\n  \"rules\": {\n    \"language\": \"python\",\n    \"entryPoint\": \"main.py\",\n    \"timeoutSeconds\": 5,\n    \"memoryLimitMb\": 128,\n    \"testCases\": [\n      { \"input\": \"5\\n\", \"expectedOutput\": \"120\" },\n      { \"input\": \"0\\n\", \"expectedOutput\": \"1\" }\n    ]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        }
      ]
    },
    {
      "name": "4. Submissions",
      "item": [
        {
          "name": "Submit Correct Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"submissionId\", jsonData.id);",
                  "pm.test(\"Status code is 202\", function () { pm.response.to.have.status(202); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskId\": {{taskId}},\n  \"contributorId\": {{contributorId}},\n  \"fileName\": \"main.py\",\n  \"sourceCode\": \"import math\\nn = int(input())\\nprint(math.factorial(n))\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/submissions", "host": ["{{baseUrl}}"], "path": ["api", "submissions"] }
          }
        },
        {
          "name": "Submit Wrong Code",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskId\": {{taskId}},\n  \"contributorId\": {{contributorId}},\n  \"fileName\": \"main.py\",\n  \"sourceCode\": \"n = int(input())\\nprint(n + 1)\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/submissions", "host": ["{{baseUrl}}"], "path": ["api", "submissions"] }
          }
        },
        {
          "name": "Get Verdict",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/submissions/{{submissionId}}", "host": ["{{baseUrl}}"], "path": ["api", "submissions", "{{submissionId}}"] }
          }
        }
      ]
    },
